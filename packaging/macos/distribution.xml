<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Fortino</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="@ARCHS@"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <os-version min="13.0"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Fortino">
        <pkg-ref id="org.fortino.pkg"/>
    </choice>
    <pkg-ref id="org.fortino.pkg" version="@VERSION@" onConclusion="none">fortino-component.pkg</pkg-ref>
</installer-gui-script>
