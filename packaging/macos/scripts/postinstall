#!/bin/sh
# Links the CLI and opens Fortino for the logged-in user, which registers the VPN service
# (the user approves it once in System Settings > General > Login Items).
APP=/Applications/Fortino.app
mkdir -p /usr/local/bin
ln -sfh "$APP/Contents/Helpers/fortino" /usr/local/bin/fortino
uid=$(stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "$uid" -ne 0 ] 2>/dev/null; then
    launchctl asuser "$uid" /usr/bin/open -g "$APP" 2>/dev/null || true
fi
exit 0
