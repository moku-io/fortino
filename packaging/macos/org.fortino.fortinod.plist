<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>org.fortino.fortinod</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/fortino/fortinod</string>
        <string>--config</string>
        <string>/Library/Application Support/Fortino/fortinod.toml</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardErrorPath</key><string>/Library/Logs/Fortino/fortinod.log</string>
    <key>StandardOutPath</key><string>/Library/Logs/Fortino/fortinod.log</string>
</dict>
</plist>
